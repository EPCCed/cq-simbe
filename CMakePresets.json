{
  "version": 10,
  "cmakeMinimumRequired": { "major": 4, "minor": 0, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CQ_SIMBE_BUILD_TESTS": true,
        "CQ_SIMBE_BUILD_EXAMPLES": true,
        "BUILD_TESTING": true
      }
    },
    {
      "name": "debug",
      "displayName": "Debug with environment toolchain",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release with environment toolchain",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug", "jobs": 2 },
    { "name": "release", "configurePreset": "release", "jobs": 2 }
  ],
  "testPresets": [
    {
      "name": "debug", "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 1, "timeout": 120, "noTestsAction": "error" }
    },
    {
      "name": "release", "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 1, "timeout": 120, "noTestsAction": "error" }
    }
  ]
}
